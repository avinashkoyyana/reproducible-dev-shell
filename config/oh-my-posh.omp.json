{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "version": 3,
  "final_space": true,
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "type": "os",
          "style": "powerline",
          "foreground": "#111827",
          "background": "#7DD3FC",
          "template": " {{ if .WSL }}WSL {{ end }}{{ .Icon }} "
        },
        {
          "type": "shell",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#111827",
          "background": "#A7F3D0",
          "template": " {{ .Name }} "
        },
        {
          "type": "path",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#F9FAFB",
          "background": "#6366F1",
          "properties": {
            "style": "folder",
            "folder_icon": "…/",
            "home_icon": "~"
          },
          "template": " \uf07c  {{ .Path }} "
        },
        {
          "type": "git",
          "style": "powerline",
          "powerline_symbol": "\ue0b0",
          "foreground": "#111827",
          "background": "#FDE68A",
          "background_templates": [
            "{{ if or (.Working.Changed) (.Staging.Changed) }}#FCA5A5{{ end }}"
          ],
          "properties": {
            "fetch_status": true,
            "fetch_upstream_icon": true
          },
          "template": " {{ .UpstreamIcon }}{{ .HEAD }}{{ if .BranchStatus }} {{ .BranchStatus }}{{ end }}{{ if .Working.Changed }}  {{ .Working.String }}{{ end }}{{ if .Staging.Changed }}  {{ .Staging.String }}{{ end }} "
        }
      ]
    },
    {
      "type": "rprompt",
      "segments": [
        {
          "type": "executiontime",
          "style": "plain",
          "foreground": "#94A3B8",
          "properties": {
            "threshold": 500
          },
          "template": " {{ .FormattedMs }} "
        },
        {
          "type": "status",
          "style": "plain",
          "foreground": "#F87171",
          "properties": {
            "always_enabled": true
          },
          "template": "{{ if ne .Code 0 }} x{{ .Code }}{{ end }}"
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "type": "text",
          "style": "plain",
          "foreground": "#A7F3D0",
          "template": "❯ "
        }
      ]
    }
  ]
}
